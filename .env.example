# ==============================================================================
# SmartHealthy - Environment Configuration Template
# Salin file ini menjadi .env lalu sesuaikan dengan pengaturan lokal Anda:
# cp .env.example .env
# ==============================================================================

# Application Settings
APP_NAME="SmartHealthy"
APP_ENV=development
APP_URL=http://localhost/SmartHealty
APP_DEBUG=true

# Database Configuration (MySQL / MariaDB via PDO)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smarthealthy
DB_USERNAME=root
DB_PASSWORD=

# Puskesmas Information
PUSKESMAS_NAME="Puskesmas Astanajapura"
PUSKESMAS_DISTRICT="Kecamatan Astanajapura"
PUSKESMAS_REGENCY="Kabupaten Cirebon"
PUSKESMAS_ADDRESS="Jl. KH. Wahid Hasyim No. 45, Astanajapura, Cirebon, Jawa Barat 45181"
PUSKESMAS_PHONE="(0231) 635123"
PUSKESMAS_HOTLINE="081234567890"
PUSKESMAS_EMAIL="puskesmas.astanajapura@cirebonkab.go.id"

# Mail & Notification Driver
# Options: mock, smtp
MAIL_DRIVER=mock
MAIL_FROM_ADDRESS="no-reply@smarthealthy.id"
MAIL_FROM_NAME="SmartHealthy Puskesmas Astanajapura"

# WhatsApp Gateway Provider (Fonnte API)
# Dokumentasi: https://docs.fonnte.com/
WA_PROVIDER=fonnte
WA_API_KEY=your_fonnte_token_here
FONNTE_TOKEN=your_fonnte_token_here
WA_SENDER_NUMBER="081234567890"

# Meta WhatsApp Cloud API (Alternatif / Opsional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN="smarthealthy_wa_webhook_verify_token_2026"
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_APP_SECRET=

# Security & Rate Limiting
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_DECAY=60
RATE_LIMIT_OTP_MAX=3
RATE_LIMIT_OTP_DECAY=60

# Artificial Intelligence (AI) - Google Gemini API
# Dapatkan API key gratis di: https://aistudio.google.com/
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_API_KEY=your_google_gemini_api_key_here
AI_MODEL=gemini-1.5-flash
