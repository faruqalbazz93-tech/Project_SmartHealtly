<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to app, database, .env
    RewriteRule ^(\.env|app|database) - [F,L,NC]

    # If request is for public assets or files, allow directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite all other URLs to index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
